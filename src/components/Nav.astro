---
import { url, unbase } from '../lib/url';

const links = [
  { href: '/#highlights', label: 'Highlights' },
  { href: '/collections', label: 'Collections' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
const path = unbase(Astro.url.pathname).replace(/\/$/, '');
---

<nav aria-label="Primary" class="nav grid4 rule-b">
  <div class="brand-cell span2">
    <a href={url('/')} class="brand"><span class="square" aria-hidden="true"></span>Tamzeed Quazi</a>
    {/* The main portfolio lives at the domain root, outside this site's base path,
        so force a full page load rather than a ClientRouter swap. */}
    <a href="/" class="portfolio label" data-astro-reload>Portfolio <span aria-hidden="true">↗</span></a>
  </div>
  <div class="links span2 rule-l">
    {
      links.map((l) => (
        <a
          href={url(l.href)}
          class="label"
          aria-current={l.href === '/collections' && path.startsWith('/collections') ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    align-items: stretch;
    background: var(--color-bg);
  }
  .brand-cell {
    display: flex;
    align-items: stretch;
  }
  .brand {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px var(--gutter);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }
  .portfolio {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 16px var(--gutter);
    border-left: var(--rule);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .portfolio:hover {
    background: var(--color-neutral-200);
    color: var(--color-text);
  }
  .square {
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    flex: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
  }
  .links a {
    flex: 1;
    padding: 16px 14px;
    color: var(--color-text);
    text-decoration: none;
  }
  .links a:hover {
    background: var(--color-neutral-200);
    color: var(--color-text);
  }

  /* Tablets: four links don't fit half the width at full spacing and would
     wrap to a second row; keep them on one row with tighter spacing. */
  @media (min-width: 760px) and (max-width: 1099.98px) {
    .links {
      flex-wrap: nowrap;
    }
    .links a {
      flex: 1 1 auto;
      padding-inline: 8px;
      letter-spacing: 0.1em;
      text-align: center;
      white-space: nowrap;
    }
  }

  /* Phones: brand on its own row, then one ruled row of content-sized links. */
  @media (max-width: 759.98px) {
    .brand-cell,
    .links {
      grid-column: 1 / -1;
    }
    .brand,
    .portfolio {
      padding-block: 14px;
    }
    .links {
      flex-wrap: nowrap;
      border-left: 0;
      border-top: var(--rule);
      overflow: hidden;
    }
    .links a {
      flex: 1 1 auto;
      padding: 12px 8px;
      margin-left: -2px;
      border-left: var(--rule);
      letter-spacing: 0.1em;
      text-align: center;
      white-space: nowrap;
    }
  }
  @media (max-width: 379.98px) {
    .links a {
      padding-inline: 5px;
      letter-spacing: 0.06em;
    }
    .portfolio {
      padding-inline: 10px;
      letter-spacing: 0.08em;
    }
  }
</style>
