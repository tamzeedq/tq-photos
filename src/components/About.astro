---
/**
 * About: portrait slot (5fr) + text column (7fr, ruled left; ruled top < 760px).
 * Copy in .placeholder-copy is written on Tamzeed's behalf — confirm before launch.
 */
import PhotoImage from './PhotoImage.astro';
import { getPhoto } from '../lib/content';

const portrait = await getPhoto('portrait');
---

<section id="about" class="about rule-b">
  <div class="portrait-cell" data-reveal>
    <div class="portrait hover-root">
      {/*
        The 4:3 portrait is cover-cropped into a 4:5 frame, so it's drawn 5/3
        (≈1.67×) wider than the frame. `sizes` describes that drawn width, not
        the frame's, or the browser picks a too-small file and upscales it.
        Frame: 100vw on phones; on desktop min(520px, ~5/12 of the viewport).
      */}
      <PhotoImage
        photo={portrait}
        aspect="4 / 5"
        sizes="(max-width: 759px) 167vw, min(867px, 70vw)"
      />
    </div>
  </div>

  <div class="text" data-reveal>
    <h2 class="t-h2">About</h2>
    <div class="copy">
      <p>
        <span class="placeholder-copy">
          I’m Tamzeed, a software developer based in Vancouver who's usually got a digicam on him. This site is where those two halves meet: a place I built to document what I’ve been up to, whether that’s travelling, hiking, or just getting through the week.
        </span>
      </p>
      <p class="strong">
        <span class="placeholder-copy"
          >I’ve always been a visual person, so I take pictures to hold on to what I see.</span
        >
      </p>
    </div>
    <div class="stats rule-t">
      <div>
        <h6>Based in</h6>
        <p class="value">Vancouver, BC</p>
      </div>
      <div class="rule-l">
        <h6>Camera</h6>
        <p class="value">Fujifilm FinePix JX560, Sony NEX-3N</p>
      </div>
      <div class="rule-l">
        <h6>Shoots</h6>
        <p class="value">Landscape, street, travel</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  /* The cell stretches to the text column's height; centre the portrait in it. */
  .portrait-cell {
    padding: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .portrait {
    width: 100%;
    max-width: 520px;
  }
  /* The portrait is a landscape shot cropped to 4:5; keep the subject (left
     third of the frame) in view rather than centre-cropping. */
  .portrait :global(img) {
    object-position: 30% 50%;
  }
  .text {
    border-left: var(--rule);
    display: flex;
    flex-direction: column;
  }
  h2 {
    padding: var(--section-top) var(--gutter) 24px;
  }
  .copy {
    padding: 0 var(--gutter) 40px;
    max-width: 640px;
  }
  .copy p {
    margin: 0 0 20px;
    font-size: 19px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .copy p.strong {
    margin: 0;
    font-weight: 600;
  }
  .stats {
    margin: auto 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .stats > div {
    padding: 16px var(--gutter);
  }
  h6 {
    margin: 0 0 6px;
  }
  .value {
    font-weight: 600;
  }

  @media (max-width: 759px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .text {
      border-left: 0;
      border-top: var(--rule);
    }
  }
</style>
