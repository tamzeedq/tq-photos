---
/**
 * Full-bleed hero. Always muted + dotted (no hover clear, no < 760px full-colour
 * rule) using --hero-filter. The `[data-parallax]` wrapper is translated by
 * scripts/motion.ts (translate3d(0, scrollY*0.3px, 0); off under reduced motion).
 */
import PhotoImage from './PhotoImage.astro';
import { getPhoto } from '../lib/content';

const photo = await getPhoto('p10');
---

<header id="top" class="hero rule-b">
  <div class="media">
    <div class="parallax" data-parallax>
      <PhotoImage photo={photo} sizes="100vw" loading="eager" fetchpriority="high" class="hero-photo" />
    </div>
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="bar grid4">
    <div class="span-all name">
      <h1 class="t-hero">Tamzeed<br />Quazi</h1>
    </div>
    <p class="span2 tagline">
      <span class="placeholder">A porfolio site of pictures I've taken on hikes, travels, and regular day to day</span>
    </p>
    <div class="span2 where label">
      <span>Vancouver, BC</span>
      <span class="scroll">Scroll <span class="cue" aria-hidden="true"></span></span>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: calc(100svh - 52px);
    min-height: 540px;
    overflow: hidden;
    background: var(--color-neutral-900);
  }
  .media {
    position: absolute;
    inset: 0;
  }
  .parallax {
    position: absolute;
    inset: -6% 0 0 0;
    width: 100%;
    height: 112%;
    will-change: transform;
  }
  .parallax :global(.photo) {
    width: 100%;
    height: 100%;
  }

  /* Hero is always muted + dotted. `.hero[data-astro-cid] .photo img` outranks
     both `.hover-root:hover .photo img` and the global < 760px full-colour rule. */
  .hero :global(.photo img) {
    filter: var(--hero-filter);
    transform: none;
  }
  .hero :global(.photo::after) {
    opacity: var(--dot-opacity);
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(32, 30, 29, 0.7), rgba(32, 30, 29, 0) 55%);
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    color: var(--color-bg);
  }
  .name {
    padding: 0 var(--gutter) 28px;
  }
  .name h1 {
    margin: 0;
    color: var(--color-bg);
  }
  .tagline {
    margin: 0;
    padding: 16px var(--gutter);
    border-top: 2px solid var(--color-bg);
    font-size: 15px;
    font-weight: 600;
  }
  .placeholder {
    /* Placeholder copy — confirm with Tamzeed. */
    border-bottom: 1px dashed rgba(243, 242, 242, 0.5);
  }
  .where {
    padding: 16px var(--gutter);
    border-top: 2px solid var(--color-bg);
    border-left: 2px solid var(--color-bg);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 12px;
  }
  .scroll {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cue {
    display: block;
    width: 1px;
    height: 36px;
    background: var(--color-bg);
    transform-origin: top;
    animation: hero-cue 2.4s ease-in-out infinite;
  }
  @keyframes hero-cue {
    0%,
    100% {
      transform: scaleY(0.4);
    }
    50% {
      transform: scaleY(1);
    }
  }
</style>
